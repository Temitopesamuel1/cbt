{
  "entities": {
    "Examination": {
      "title": "Examination",
      "description": "School examination specification created and configured by teachers or administrators",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 150 },
        "subjectId": { "type": "string", "maxLength": 100 },
        "subjectName": { "type": "string", "maxLength": 100 },
        "classGrade": { "type": "string", "maxLength": 50 },
        "academicSession": { "type": "string", "maxLength": 20 },
        "term": { "type": "string", "maxLength": 20 },
        "examType": { "type": "string", "maxLength": 50 },
        "targetCaComponent": { "type": "string", "enum": ["first_ca", "second_ca", "exam"] },
        "durationMinutes": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "totalMarks": { "type": "number" },
        "passingScore": { "type": "number" },
        "instructions": { "type": "string", "maxLength": 2000 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "teacherName": { "type": "string", "maxLength": 120 },
        "status": { "type": "string", "enum": ["draft", "published", "archived"] },
        "shuffleQuestions": { "type": "boolean" },
        "shuffleOptions": { "type": "boolean" },
        "resultVisibility": { "type": "string", "enum": ["immediate", "teacher_publish"] },
        "startDate": { "type": "string", "maxLength": 60 },
        "endDate": { "type": "string", "maxLength": 60 },
        "enableAntiCheat": { "type": "boolean" },
        "maxTabSwitches": { "type": "number" },
        "requireFullscreen": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "subjectName", "classGrade", "durationMinutes", "totalQuestions", "teacherId", "status"]
    },
    "Question": {
      "title": "Question",
      "description": "Examination multiple choice objective question with curriculum topic tracking and optional diagrams",
      "type": "object",
      "properties": {
        "examId": { "type": "string", "maxLength": 128 },
        "questionNumber": { "type": "number" },
        "text": { "type": "string", "maxLength": 4000 },
        "imageUrl": { "type": "string" },
        "optionA": { "type": "string", "maxLength": 800 },
        "optionB": { "type": "string", "maxLength": 800 },
        "optionC": { "type": "string", "maxLength": 800 },
        "optionD": { "type": "string", "maxLength": 800 },
        "optionAImage": { "type": "string" },
        "optionBImage": { "type": "string" },
        "optionCImage": { "type": "string" },
        "optionDImage": { "type": "string" },
        "correctOption": { "type": "string", "enum": ["A", "B", "C", "D"] },
        "subject": { "type": "string", "maxLength": 100 },
        "topic": { "type": "string", "maxLength": 120 },
        "explanation": { "type": "string", "maxLength": 2000 }
      },
      "required": ["examId", "questionNumber", "text", "optionA", "optionB", "optionC", "optionD", "correctOption"]
    },
    "Student": {
      "title": "Student",
      "description": "Enrolled secondary school student profile with institutional admission identifier",
      "type": "object",
      "properties": {
        "admissionNumber": { "type": "string", "maxLength": 60 },
        "accessCode": { "type": "string", "maxLength": 60 },
        "firstName": { "type": "string", "maxLength": 60 },
        "surname": { "type": "string", "maxLength": 60 },
        "fullName": { "type": "string", "maxLength": 140 },
        "email": { "type": "string", "maxLength": 120 },
        "password": { "type": "string", "maxLength": 120 },
        "passportUrl": { "type": "string" },
        "gender": { "type": "string", "maxLength": 20 },
        "phoneNumber": { "type": "string", "maxLength": 30 },
        "dateOfBirth": { "type": "string", "maxLength": 30 },
        "stateOfOrigin": { "type": "string", "maxLength": 60 },
        "department": { "type": "string", "maxLength": 80 },
        "bio": { "type": "string", "maxLength": 500 },
        "classGrade": { "type": "string", "maxLength": 50 },
        "classId": { "type": "string", "maxLength": 60 },
        "academicSession": { "type": "string", "maxLength": 20 },
        "cgpa": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "suspended", "graduated"] },
        "resultWithheld": { "type": "boolean" },
        "withheldSubjectIds": { "type": "array" },
        "withheldReason": { "type": "string", "maxLength": 300 },
        "registeredAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["admissionNumber", "firstName", "surname", "classGrade", "status"]
    },
    "SchoolClass": {
      "title": "SchoolClass",
      "description": "Academic class or form cohort in the secondary school",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "code": { "type": "string", "maxLength": 30 },
        "arm": { "type": "string", "maxLength": 20 },
        "academicSession": { "type": "string", "maxLength": 20 },
        "studentCount": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "code", "academicSession"]
    },
    "Subject": {
      "title": "Subject",
      "description": "Academic curriculum subject taught within the school",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "code": { "type": "string", "maxLength": 30 },
        "department": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "code", "department"]
    },
    "ExamAttempt": {
      "title": "ExamAttempt",
      "description": "Live session state tracking for student examination progress and disconnection recovery",
      "type": "object",
      "properties": {
        "examId": { "type": "string", "maxLength": 128 },
        "examTitle": { "type": "string", "maxLength": 150 },
        "subjectName": { "type": "string", "maxLength": 100 },
        "classGrade": { "type": "string", "maxLength": 50 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentAdmissionNumber": { "type": "string", "maxLength": 60 },
        "studentName": { "type": "string", "maxLength": 140 },
        "startTime": { "type": "string", "format": "date-time" },
        "endTime": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["in_progress", "submitted", "timed_out", "retake_granted"] },
        "savedAnswers": { "type": "object" },
        "flaggedQuestions": { "type": "object" },
        "tabSwitchCount": { "type": "number" },
        "currentQuestionIndex": { "type": "number" },
        "answeredCount": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "lastWarning": { "type": "string", "maxLength": 300 },
        "lastHeartbeatAt": { "type": "string", "format": "date-time" },
        "retakeGrantedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["examId", "studentId", "startTime", "endTime", "status"]
    },
    "Submission": {
      "title": "Submission",
      "description": "Official graded student answer sheet with topic assessment analytics",
      "type": "object",
      "properties": {
        "attemptId": { "type": "string", "maxLength": 160 },
        "examId": { "type": "string", "maxLength": 128 },
        "examTitle": { "type": "string", "maxLength": 150 },
        "subject": { "type": "string", "maxLength": 100 },
        "classGrade": { "type": "string", "maxLength": 50 },
        "academicSession": { "type": "string", "maxLength": 20 },
        "term": { "type": "string", "maxLength": 20 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 140 },
        "admissionNumber": { "type": "string", "maxLength": 60 },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "percentage": { "type": "number" },
        "timeSpentSeconds": { "type": "number" },
        "answers": { "type": "object" },
        "submittedAt": { "type": "string", "format": "date-time" },
        "attemptNumber": { "type": "number" },
        "sittingLabel": { "type": "string", "maxLength": 40 },
        "targetCaComponent": { "type": "string", "enum": ["first_ca", "second_ca", "exam"] },
        "detailedResults": { "type": "array" },
        "topicAnalysis": { "type": "object" },
        "aiRevisionRecommendations": { "type": "array" }
      },
      "required": ["examId", "studentName", "admissionNumber", "score", "totalQuestions", "percentage", "submittedAt"]
    },
    "AssessmentRecord": {
      "title": "AssessmentRecord",
      "description": "Continuous assessment and examination broadsheet scores per student and subject",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 140 },
        "admissionNumber": { "type": "string", "maxLength": 60 },
        "classGrade": { "type": "string", "maxLength": 50 },
        "subjectId": { "type": "string", "maxLength": 100 },
        "subjectName": { "type": "string", "maxLength": 100 },
        "academicSession": { "type": "string", "maxLength": 20 },
        "term": { "type": "string", "maxLength": 20 },
        "assignmentScore": { "type": "number" },
        "firstCaScore": { "type": "number" },
        "secondCaScore": { "type": "number" },
        "projectScore": { "type": "number" },
        "testScore": { "type": "number" },
        "examScore": { "type": "number" },
        "totalScore": { "type": "number" },
        "grade": { "type": "string", "maxLength": 10 },
        "remark": { "type": "string", "maxLength": 60 },
        "teacherComment": { "type": "string", "maxLength": 500 },
        "classAverage": { "type": "number" },
        "teacherSignature": { "type": "string", "maxLength": 120 },
        "cbtSubmissionId": { "type": "string", "maxLength": 128 },
        "examEntries": { "type": "array" },
        "isAutoSynced": { "type": "boolean" },
        "explicitlySaved": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "subjectId", "classGrade", "academicSession", "term"]
    },
    "TermReport": {
      "title": "TermReport",
      "description": "End-of-term student bio, psychomotor behaviours, skills ratings, remarks, and fee schedule",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 140 },
        "admissionNumber": { "type": "string", "maxLength": 60 },
        "classGrade": { "type": "string", "maxLength": 50 },
        "academicSession": { "type": "string", "maxLength": 20 },
        "term": { "type": "string", "maxLength": 20 },
        "age": { "type": "string", "maxLength": 20 },
        "house": { "type": "string", "maxLength": 40 },
        "sex": { "type": "string", "maxLength": 20 },
        "noInClass": { "type": "string", "maxLength": 20 },
        "department": { "type": "string", "maxLength": 80 },
        "category": { "type": "string", "maxLength": 80 },
        "classAverage": { "type": "string", "maxLength": 30 },
        "overallPosition": { "type": "string", "maxLength": 20 },
        "behaviours": { "type": "object" },
        "skills": { "type": "object" },
        "classTeacherRemarks": { "type": "string", "maxLength": 500 },
        "principalRemarks": { "type": "string", "maxLength": 500 },
        "nextTermBegins": { "type": "string", "maxLength": 80 },
        "nextTermFees": { "type": "string", "maxLength": 40 },
        "principalSignature": { "type": "string", "maxLength": 120 },
        "proprietressSignature": { "type": "string", "maxLength": 120 },
        "customLabels": { "type": "object" },
        "updatedBy": { "type": "string", "maxLength": 140 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "academicSession", "term"]
    },
    "LessonNote": {
      "title": "LessonNote",
      "description": "Curriculum-aligned teacher lesson plan and instructional note",
      "type": "object",
      "properties": {
        "teacherId": { "type": "string", "maxLength": 128 },
        "teacherName": { "type": "string", "maxLength": 140 },
        "subjectName": { "type": "string", "maxLength": 100 },
        "classGrade": { "type": "string", "maxLength": 50 },
        "term": { "type": "string", "maxLength": 20 },
        "weekNumber": { "type": "number" },
        "topic": { "type": "string", "maxLength": 200 },
        "subTopic": { "type": "string", "maxLength": 200 },
        "durationMinutes": { "type": "number" },
        "behavioralObjectives": { "type": "array" },
        "instructionalMaterials": { "type": "array" },
        "previousKnowledge": { "type": "string", "maxLength": 1000 },
        "content": { "type": "string", "maxLength": 12000 },
        "visualsAndCharts": { "type": "string", "maxLength": 4000 },
        "teacherActivities": { "type": "array" },
        "studentActivities": { "type": "array" },
        "evaluationQuestions": { "type": "array" },
        "summary": { "type": "string", "maxLength": 1000 },
        "assignment": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teacherId", "subjectName", "classGrade", "topic"]
    },
    "SchoolSettings": {
      "title": "SchoolSettings",
      "description": "Institutional branding, assessment policies, CA weights, grading scale, and portal controls",
      "type": "object",
      "properties": {
        "schoolName": { "type": "string", "maxLength": 150 },
        "address": { "type": "string", "maxLength": 300 },
        "location": { "type": "string", "maxLength": 150 },
        "motto": { "type": "string", "maxLength": 250 },
        "principalName": { "type": "string", "maxLength": 120 },
        "examOfficerName": { "type": "string", "maxLength": 120 },
        "resultTitle": { "type": "string", "maxLength": 200 },
        "resultSubtitle": { "type": "string", "maxLength": 200 },
        "securityNotice": { "type": "string", "maxLength": 500 },
        "phone": { "type": "string", "maxLength": 60 },
        "email": { "type": "string", "maxLength": 120 },
        "website": { "type": "string", "maxLength": 120 },
        "studentIdPrefix": { "type": "string", "maxLength": 20 },
        "schoolLogo": { "type": "string" },
        "academicSession": { "type": "string", "maxLength": 30 },
        "currentTerm": { "type": "string", "maxLength": 30 },
        "passMarkPercentage": { "type": "number" },
        "allowImmediateResultViewing": { "type": "boolean" },
        "announcementBanner": { "type": "string", "maxLength": 1000 },
        "isStudentPortalActive": { "type": "boolean" },
        "isTeacherPortalActive": { "type": "boolean" },
        "enableAiAdvisor": { "type": "boolean" },
        "enablePracticeCenter": { "type": "boolean" },
        "enableChatHub": { "type": "boolean" },
        "enableLessonGenerator": { "type": "boolean" },
        "caWeights": { "type": "object" },
        "gradingScale": { "type": "array" },
        "nextTermBegins": { "type": "string", "maxLength": 80 },
        "nextTermFees": { "type": "string", "maxLength": 40 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["schoolName", "academicSession", "currentTerm"]
    },
    "CloudSyncState": {
      "title": "CloudSyncState",
      "description": "Authoritative deletion tombstones and cross-device sync state markers",
      "type": "object",
      "properties": {
        "hasBootstrapped": { "type": "boolean" },
        "deletedAdminIds": { "type": "array" },
        "deletedExamIds": { "type": "array" },
        "deletedStaffIds": { "type": "array" },
        "deletedClassIds": { "type": "array" },
        "deletedSubjectIds": { "type": "array" },
        "deletedStudentIds": { "type": "array" },
        "deletedSubmissionIds": { "type": "array" },
        "deletedCaRecordIds": { "type": "array" },
        "deletedLessonNoteIds": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "StaffMember": {
      "title": "StaffMember",
      "description": "Faculty staff teacher profile with assigned teaching subjects, classes, and login ID",
      "type": "object",
      "properties": {
        "uniqueId": { "type": "string", "maxLength": 50 },
        "fullName": { "type": "string", "maxLength": 140 },
        "email": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["teacher", "hod"] },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "assignedSubjectIds": { "type": "array" },
        "assignedSubjectNames": { "type": "array" },
        "assignedClasses": { "type": "array" },
        "qualification": { "type": "string", "maxLength": 120 },
        "courseOfStudy": { "type": "string", "maxLength": 120 },
        "phoneNumber": { "type": "string", "maxLength": 30 },
        "password": { "type": "string", "maxLength": 120 },
        "avatarUrl": { "type": "string" },
        "bio": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uniqueId", "fullName", "email", "status"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Administrator account with authority over institution, faculty, curriculum, and settings",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 120 },
        "fullName": { "type": "string", "maxLength": 140 },
        "role": { "type": "string", "enum": ["super_admin", "admin", "vice_principal", "examination_officer"] },
        "passcode": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "isMainSuperAdmin": { "type": "boolean" },
        "assignedPermissions": { "type": "array" },
        "phoneNumber": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "fullName", "role", "status"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Real-time WhatsApp-style campus message with optional media attachments and replies",
      "type": "object",
      "properties": {
        "channelId": { "type": "string", "maxLength": 150 },
        "channelName": { "type": "string", "maxLength": 150 },
        "channelType": { "type": "string", "enum": ["staff_group", "student_class_group", "campus_group", "direct_teacher", "direct_student", "student_to_teacher"] },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 140 },
        "senderRole": { "type": "string", "enum": ["super_admin", "admin", "teacher", "student"] },
        "recipientId": { "type": "string", "maxLength": 128 },
        "recipientName": { "type": "string", "maxLength": 140 },
        "text": { "type": "string", "maxLength": 4000 },
        "attachmentUrl": { "type": "string" },
        "attachmentType": { "type": "string", "enum": ["image", "audio", "document"] },
        "attachmentName": { "type": "string", "maxLength": 200 },
        "attachmentSize": { "type": "string", "maxLength": 40 },
        "voiceDurationSeconds": { "type": "number" },
        "replyToId": { "type": "string", "maxLength": 128 },
        "replyToSender": { "type": "string", "maxLength": 140 },
        "replyToText": { "type": "string", "maxLength": 500 },
        "deleted": { "type": "boolean" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["channelId", "channelType", "senderId", "senderName", "senderRole", "timestamp"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": "AdminUser",
      "description": "Authorized administrators with app management permissions"
    },
    "/teachers/{teacherId}": {
      "schema": "StaffMember",
      "description": "Teaching faculty and staff records with unique access codes"
    },
    "/examinations/{examId}": {
      "schema": "Examination",
      "description": "School examinations configured by academic departments"
    },
    "/examinations/{examId}/questions/{questionId}": {
      "schema": "Question",
      "description": "Questions with topic tagging belonging to an examination"
    },
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Registered students in the secondary school directory"
    },
    "/classes/{classId}": {
      "schema": "SchoolClass",
      "description": "Class levels and arm rosters"
    },
    "/subjects/{subjectId}": {
      "schema": "Subject",
      "description": "Curriculum subjects"
    },
    "/attempts/{attemptId}": {
      "schema": "ExamAttempt",
      "description": "Active in-progress test sessions for disconnection recovery"
    },
    "/submissions/{submissionId}": {
      "schema": "Submission",
      "description": "Completed student graded test records and analytics"
    },
    "/caRecords/{recordId}": {
      "schema": "AssessmentRecord",
      "description": "Continuous assessment broadsheet scores, test marks, and academic grades"
    },
    "/termReports/{reportId}": {
      "schema": "TermReport",
      "description": "End-of-term student bio, psychomotor, skills, remarks, and fees data"
    },
    "/lesson_notes/{noteId}": {
      "schema": "LessonNote",
      "description": "Saved teacher lesson notes and instructional guides"
    },
    "/chat_messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Real-time campus communications messages across group rooms and direct messages"
    },
    "/settings/school": {
      "schema": "SchoolSettings",
      "description": "Global school settings and session configuration"
    },
    "/settings/syncState": {
      "schema": "CloudSyncState",
      "description": "Authoritative cross-device deletion tombstones and sync markers"
    }
  }
}
