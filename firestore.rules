rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Health check & connectivity
    match /test/connection {
      allow read: if true;
    }

    // Administrators collection
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Teachers collection
    match /teachers/{teacherId} {
      allow read, write: if true;
    }

    // Classes & Subjects
    match /classes/{classId} {
      allow read, write: if true;
    }

    match /subjects/{subjectId} {
      allow read, write: if true;
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Students registration
    match /students/{studentId} {
      allow read, write: if true;
    }

    // Examinations collection
    match /examinations/{examId} {
      allow read, write: if true;

      // Questions subcollection
      match /questions/{questionId} {
        allow read, write: if true;
      }
    }

    // In-progress student attempts (disconnection recovery)
    match /attempts/{attemptId} {
      allow read, write: if true;
    }

    // Submissions collection
    match /submissions/{submissionId} {
      allow read, write: if true;
    }

    // Continuous Assessment & Report Sheet Records
    match /caRecords/{recordId} {
      allow read, write: if true;
    }

    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
